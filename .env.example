# Copy to .env and fill local values. Do not commit .env.
RAG_RETRIEVAL_PROVIDER=pgvector
RAG_PG_EMBEDDING_PROFILE_ID=qwen3.7-text-embedding
RAG_PG_CONNECT_TIMEOUT_SECONDS=5

# Real embedding (OpenAI-compatible /v1/embeddings)
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
RAG_EMBEDDING_API_KEY=fill-me
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_MODEL_VERSION=qwen3.7-text-embedding-1024-v1
RAG_EMBEDDING_TIMEOUT_MS=10000

# Optional answer/rewrite/rerank models
RAG_REWRITE_BASE_URL=
RAG_REWRITE_API_KEY=
RAG_REWRITE_MODEL=deterministic-rewrite-v1
RAG_REWRITE_MODEL_VERSION=deterministic-rewrite-v1
RAG_REWRITE_TIMEOUT_MS=10000
RAG_ANSWER_BASE_URL=
RAG_ANSWER_API_KEY=
RAG_ANSWER_PROVIDER=openai-compatible
RAG_ANSWER_MODEL=deterministic-answer-v1
RAG_ANSWER_MODEL_VERSION=deterministic-answer-v1
RAG_ANSWER_TIMEOUT_MS=30000
RAG_RERANK_API_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL_VERSION=external-rerank-v1
RAG_RERANK_TIMEOUT_MS=3000

# Optional evaluation/observability
RAGAS_API_URL=
RAGAS_API_KEY=
RAGAS_TIMEOUT_MS=10000
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_MS=5000
RAG_JUDGE_API_URL=
RAG_JUDGE_API_KEY=
RAG_JUDGE_MODEL_VERSION=judge-v1
RAG_JUDGE_TIMEOUT_MS=10000

# Isolated MinIO resources
RAG_MINIO_ENDPOINT=http://your-minio-host:9000
RAG_MINIO_BUCKET=agentic-retrieval
RAG_MINIO_ACCESS_KEY=fill-me
RAG_MINIO_SECRET_KEY=fill-me
RAG_MINIO_REGION=us-east-1
RAG_MINIO_SECURE=false
RAG_MINIO_PREFIX=agentic-retrieval/

# Chunk Lab formal PostgreSQL/pgvector (read-only adapter)
RAG_PG_HOST=your-pg-host
RAG_PG_PORT=5432
RAG_PG_DATABASE=your_database
RAG_PG_USER=your_user
RAG_PG_PASSWORD=fill-me
RAG_PG_SSLMODE=prefer
RAG_PG_SCHEMA=rag
RAG_PG_VECTOR_TABLE=vector_records_v2_d1024
RAG_PG_EMBEDDING_PROFILE_ID=qwen3.7-text-embedding
RAG_EMBEDDING_DIMENSIONS=1024
RAG_PG_BM25_INDEX=vector_records_v2_d1024_bm25_idx
RAG_PG_BM25_KEY_FIELD=retrieval_key
